{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intmusic.local/schemas/events.schema.json",
  "title": "IntMusic WebSocket Event",
  "type": "object",
  "required": ["id", "type", "time", "payload"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "enum": [
        "core.ready",
        "scan.started",
        "scan.progress",
        "scan.finished",
        "scan.problem_found",
        "library.changed",
        "library.client_manifest_changed",
        "client.mutations_applied",
        "artist.updated",
        "artist.asset.ready",
        "artist.visual.updated",
        "track.metadata_changed",
        "track.recording_changed",
        "playback.state_changed",
        "playback.position",
        "playback.queue_changed",
        "zone.alias_updated",
        "zone.volume_changed",
        "renderer.command",
        "renderer.registered",
        "renderer.resync_required",
        "connection.pong",
        "connection.snapshot_required",
        "distribution.created",
        "distribution.updated",
        "distribution.task_claimed",
        "distribution.source_task_claimed",
        "distribution.transcoding",
        "core.settings_changed"
      ]
    },
    "time": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
