{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "mkdir",
            "args": [
                "-p",
                "build"
            ]
        },
        // {
        //     "label": "prepare-build-windows",
        //     "type": "shell",
        //     "options": {
        //         "cwd": "${workspaceFolder}",
        //     },
        //     "command": "powershell",
        //     "args": [
        //         "-ExecutionPolicy", "Bypass",
        //         "-File", "${workspaceFolder}/scripts/prepare-build.ps1",
        //         "-WorkspaceFolder", "${workspaceFolder}"
        //     ]
        // },
        {
            "label": "prepare-build-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "command": "docker",
            "args": [
                "run",
                "-it",
                "--rm",
                "-v",
                "${workspaceFolder}:/project",
                "qt-build-windows:shared.6.8.3",
                "/bin/bash",
                "-c",
                "'cmake --build /project/build/debug --target clean'",
            ]
        },
        // Windows Debug
        {
            "label": "make-build-debug-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "command": "docker",
            "args": [
                "run",
                "-it",
                "--rm",
                "-v",
                "${workspaceFolder}:/project",
                "qt-build-windows:shared.6.8.3",
                "/bin/bash",
                "-c",
                "'cmake -B /project/build/debug/ -S /project  -DCMAKE_TOOLCHAIN_FILE=${config:CMAKE_TOOLCHAIN_FILE} -DCMAKE_BUILD_TYPE=Debug && cmake --build /project/build/debug'",
            ],
            "dependsOn": [
                "prepare-build-windows"
            ]
        },
        {
            "label": "make-install-debug-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "docker",
            "args": [
                "run",
                "-it",
                "-v",
                "${workspaceFolder}:/project",
                "qt-build-windows:shared.6.8.3",
                "/bin/bash",
                "-c",
                "'cmake --install /project/build/debug --prefix /project/build/debug'"
            ],
            "dependsOn": [
                "make-build-debug-windows"
            ]
        },
        {
            "label": "run-debug-windows",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/build/debug/bin"
            },
            "command": "IntMusic.exe",
            "dependsOn": [
                "make-install-debug-windows"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },

        // Mac Debug
        {
            "label": "make-debug-mac",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "${config:QT_CMAKE_PROGRAM_MAC}",
            "args": [
                "\"-S ${workspaceFolder}\"",
                "-Bbuild/debug",
                "-GNinja",
            ],
            "dependsOn": [
                "mkdir"
            ]
        },
        {
            "label": "make-build-debug-mac",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build/debug"
            },
            "command": "ninja",
            "args": [],
            "dependsOn": [
                "make-debug-mac"
            ]
        },
        {
            "label": "run-debug-mac",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/build/debug/"
            },
            "command": "open",
            "args": [
                "-a", "IntMusic.app"
            ],
            "dependsOn": [
                "make-build-debug-mac"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },

        // Windows Release
        {
            "label": "make-release-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "C:/Qt/Tools/CMake_64/bin/cmake.exe",
            "args": [
                "-Bbuild/release",
                "-GNinja",
                "-DCMAKE_MAKE_PROGRAM=${config:NINJA_PROGRAM_WIN}",
                "\"-DCMAKE_TOOLCHAIN_FILE:FILEPATH=../mingw-toolchain.cmake\"",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_PROJECT_INCLUDE_BEFORE=${config:QT_AUTO_SETUP_WIN}",
                "-DCMAKE_PREFIX_PATH=${config:CMAKE_PREFIX_PATH_WIN}"
            ],
            "dependsOn": ["mkdir-windows"]
        },
        {
            "label": "make-build-release-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "C:/Qt/Tools/CMake_64/bin/cmake.exe",
            "args": [
                "--build",
                "./build/release",
                "--target",
                "all",
                "--config",
                "Release"
            ],
            "dependsOn": ["make-release-windows"]
        },
        {
            "label": "make-install-release-windows",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "C:/Qt/Tools/CMake_64/bin/cmake.exe",
            "args": [
                "--install",
                "./build/release",
                "--prefix",
                "${workspaceFolder}/build/release"
            ],
            "dependsOn": [
                "make-build-release-windows"
            ]
        },
        {
            "label": "run-release-windows",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/build/release/bin"
            },
            "command": "IntMusic.exe",
            "dependsOn": ["make-install-release-windows"],
            "problemMatcher": ["$gcc"]
        },

        // Mac Release
        {
            "label": "make-release-mac",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "${config:QT_CMAKE_PROGRAM_MAC}",
            "args": [
                "\"-S ${workspaceFolder}\"",
                "-Bbuild/release",
                "-GNinja",
            ],
            "dependsOn": [
                "mkdir"
            ]
        },
        {
            "label": "make-build-release-mac",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build/release"
            },
            "command": "ninja",
            "args": [],
            "dependsOn": [
                "make-release-mac"
            ]
        },
        {
            "label": "run-release-mac",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}/build/release/"
            },
            "command": "open",
            "args": [
                "-a", "IntMusic.app"
            ],
            "dependsOn": [
                "make-build-release-mac"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}